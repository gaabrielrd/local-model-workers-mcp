# Protected configuration. Copy values into the server process environment.
# LMW_PROVIDERS is the only provider contract; keep credentials here, never in
# repository files or editable preferences.
#
# tls_verify is optional. Unset means the default for the host: certificates are
# verified for any remote provider, and loopback keeps plain HTTP. Set it to
# false only to deliberately accept an unencrypted or unverified remote endpoint.
LMW_PROVIDERS=[{"name":"lm-studio","type":"lm-studio","base_url":"http://127.0.0.1:1234/v1","allowed_models":["replace-with-an-allowed-model-id"],"priority":0}]

# Optional multi-provider mode with a fallback.
# LMW_PROVIDERS=[{"name":"primary","type":"ollama","base_url":"http://127.0.0.1:11434","allowed_models":["replace-with-an-allowed-model-id"],"priority":0},{"name":"fallback","type":"vllm","base_url":"https://models.example.internal/v1","bearer_token":"replace-with-a-token","allowed_models":["replace-with-an-allowed-model-id"],"priority":10}]
# LMW_PROVIDER_RECHECK_INTERVAL_MS=60000
