# Protected configuration. Copy values into the server process environment.
LMW_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Optional. Leave unset or empty when the LM Studio server has no token support.
LMW_LM_STUDIO_BEARER_TOKEN=
LMW_ALLOWED_MODELS=["replace-with-an-allowed-model-id"]

# Optional multi-provider mode. When set, this replaces the three legacy
# LM Studio variables above. Keep credentials in the process environment only.
# LMW_PROVIDERS=[{"name":"primary","type":"ollama","base_url":"http://127.0.0.1:11434","allowed_models":["replace-with-an-allowed-model-id"],"priority":0},{"name":"fallback","type":"vllm","base_url":"http://127.0.0.1:8000/v1","bearer_token":"replace-with-a-token","allowed_models":["replace-with-an-allowed-model-id"],"priority":10}]
# LMW_PROVIDER_RECHECK_INTERVAL_MS=60000
