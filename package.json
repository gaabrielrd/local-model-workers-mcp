{
  "name": "local-model-workers-mcp",
  "version": "2.4.0",
  "description": "Local Model Workers MCP server for bounded repository exploration, code graph queries, type/lint fixes, and test proposals delegated to local LLMs (LM Studio, Ollama, vLLM, LocalAI).",
  "license": "MIT",
  "author": "Gabriel Rodriguez",
  "homepage": "https://github.com/gaabrielrd/local-model-workers-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaabrielrd/local-model-workers-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gaabrielrd/local-model-workers-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lm-studio",
    "ollama",
    "vllm",
    "localai",
    "local-llm",
    "claude-code",
    "codex",
    "cursor",
    "vscode",
    "neovim"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "local-model-workers-mcp": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "scripts/wsl2",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/set-executable.mjs",
    "check:boundaries": "node --import tsx scripts/check-feature-boundaries.ts",
    "clean": "node scripts/clean.mjs",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "lint": "eslint . --max-warnings 0",
    "pack:check": "npm pack --dry-run --json --ignore-scripts",
    "pretest": "npm run build",
    "pretest:unit": "npm run build",
    "pretest:integration": "npm run build",
    "release:smoke": "node scripts/release/smoke-package.mjs",
    "release:measure": "node scripts/release/measure-scenarios.mjs",
    "test": "node --import tsx --test --test-concurrency=4 --test-timeout=30000 test/*.test.ts test/integration/*.test.ts",
    "test:unit": "node --import tsx --test --test-concurrency=4 --test-timeout=30000 test/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 --test-timeout=30000 test/integration/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run format:check && npm run lint && npm run check:boundaries && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  }
}
