{
  "name": "local-model-workers-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Local MCP server for bounded repository work delegated to LM Studio.",
  "type": "module",
  "bin": {
    "local-model-workers-mcp": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/set-executable.mjs",
    "check:boundaries": "node --import tsx scripts/check-feature-boundaries.ts",
    "clean": "node scripts/clean.mjs",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "lint": "eslint . --max-warnings 0",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run format:check && npm run lint && npm run check:boundaries && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
